{
  "name": "english-profile-generator",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "Windows 本地运行的虚构英文社交账号资料生成器",
  "scripts": {
    "dev": "vite",
    "start": "vite --host 127.0.0.1 --open",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.59.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tensorflow/tfjs": "^4.11.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@upscalerjs/esrgan-slim": "^1.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "upscaler": "^1.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
